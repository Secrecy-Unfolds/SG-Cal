# Postgres connection string (e.g. from Vercel Postgres / Neon integration)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random long random string used to sign login session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Apps Script mail relay (POST { token, to, subject, body, name }).
# Optional — only set this if you redeploy the script to a different URL;
# otherwise the app already defaults to the one you gave it.
EMAIL_ENDPOINT_URL=

# The "token" field the Apps Script expects to authorize send requests.
EMAIL_TOKEN=

# The "name" field the Apps Script uses as the sender/company name.
EMAIL_SENDER_NAME=

# Secret Vercel Cron sends back as "Authorization: Bearer <value>" to prove
# the request came from Vercel's scheduler and not a random visitor.
# Generate one the same way as SESSION_SECRET.
CRON_SECRET=

# --- One-time account setup (used only by `npm run setup`, then you can
#     remove these four lines from your .env if you like) ---
SEED_USER1_USERNAME=
SEED_USER1_PASSWORD=
SEED_USER1_EMAIL=

SEED_USER2_USERNAME=
SEED_USER2_PASSWORD=
SEED_USER2_EMAIL=
